# --- Database (Postgres is NOT published to the host) ---
POSTGRES_USER=leaddesk
POSTGRES_PASSWORD=leaddesk_dev_password
POSTGRES_DB=leaddesk

# --- Backend ---
# Generate a real one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# false for local http, true in production (https)
COOKIE_SECURE=false

# --- Published ports ---
BACKEND_PORT=3001
FRONTEND_PORT=3000
